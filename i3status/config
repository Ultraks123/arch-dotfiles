general {
        colors = true
        interval = 5
        color_good = "#ffffff"
        color_bad = "#ffffff"
        color_degraded = "#ffffff"
}

order += "ethernet _first_"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

ethernet _first_ {
        format_up = "E: %ip"
        format_down = "E: down"
}

disk "/" {
        format = "HDD: %avail"
}

load {
        format = "CPU: %1min"
}

memory {
        format = "RAM: %available"
        threshold_degraded = "1G"
        format_degraded = "RAM LOW: %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}
